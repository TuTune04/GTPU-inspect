# 4G G-PDU cơ bản, không cờ tùy chọn
# idx verdict teid msg_type qfi # ghi chú
0 ok 0x00001001 255 - # UL TCP, phiên 1
1 ok 0x00001001 255 - # UL TCP, phiên 1
2 ok 0x00001001 255 - # UL TCP, phiên 1
3 ok 0x00002001 255 - # DL TCP, phiên 1 (TEID chiều xuống khác chiều lên)
4 ok 0x00001002 255 - # UL UDP (DNS), phiên 2
5 ok 0x00001003 255 - # UL ICMP, phiên 3: inner không phải TCP/UDP
6 ok 0xffffffff 255 - # TEID lớn nhất, kiểm tra ntohl/kiểu unsigned
7 ok 0x00001001 255 - # UL TCP payload lớn, phiên 1
